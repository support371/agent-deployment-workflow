# ---------------------------------------------------------------------------
# GEM Agent Builder — environment template
# Copy to .env.local for local dev; set the same vars in Vercel Project → Vars
# for preview/production. Every var here is read & validated by lib/env.ts.
# ---------------------------------------------------------------------------

# --- Agent model provider -----------------------------------------------------
# Which LLM drives the tool-use loop. Must be one of: anthropic | openai
AGENT_PROVIDER=anthropic

# --- Anthropic (Claude) -------------------------------------------------------
# Required when AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenAI -------------------------------------------------------------------
# Required when AGENT_PROVIDER=openai
OPENAI_API_KEY=
# Optional override; defaults to gpt-4o
OPENAI_MODEL=gpt-4o

# --- Vercel Sandbox -----------------------------------------------------------
# In production on Vercel, VERCEL_OIDC_TOKEN is injected automatically and
# TEAM_ID / PROJECT_ID are resolved from the deployment context.
# For local dev or CI, provide a classic VERCEL_TOKEN with Sandbox scope
# plus the team + project IDs.
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
VERCEL_OIDC_TOKEN=

# --- Vercel Deploy ------------------------------------------------------------
# Optional. If set, the agent can trigger a production deploy after a
# successful PR merge (see lib/vercel-deploy.ts).
VERCEL_DEPLOY_HOOK_URL=

# --- GitHub -------------------------------------------------------------------
# Optional. Needed for the chat → commit → PR flow in lib/github.ts.
# Token must have repo scope (or fine-grained contents:write + pull_requests:write).
GITHUB_TOKEN=
# Default org/user used when the caller doesn't pass an explicit owner.
GITHUB_DEFAULT_OWNER=

# --- API Authentication -------------------------------------------------------
# Optional shared secret. If set, /api/agent requires
# `Authorization: Bearer <GEM_AGENT_TOKEN>` on every request.
GEM_AGENT_TOKEN=

# --- Runtime ------------------------------------------------------------------
# Usually set by the runtime itself; override only for tests.
NODE_ENV=development
