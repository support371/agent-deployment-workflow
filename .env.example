# ── GEM Agent Builder · environment reference ──
# `npm run setup` populates these automatically. Copy to .env.local
# only if you want to fill them by hand.

# Which model provider drives the agent loop: anthropic | openai
AGENT_PROVIDER=anthropic

# ── Anthropic (Claude) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── OpenAI (only when AGENT_PROVIDER=openai) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Vercel Sandbox auth ──
# Production: VERCEL_OIDC_TOKEN is injected automatically by Vercel.
# Locally: run `vercel link` then `vercel env pull` or `npm run setup`.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_OIDC_TOKEN=

# ── Deploy hook — triggers production deploy on green build ──
# Created automatically by `npm run setup` (POST /v1/projects/{id}/deploy-hooks)
VERCEL_DEPLOY_HOOK_URL=

# ── GitHub PR flow (optional) ──
# Fine-grained PAT with Contents: RW + Pull Requests: RW on the target repo.
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=

# ── API bearer token ──
# Protects /api/agent and /api/deploy. Generated by setup.
# If unset, routes are open (local dev only).
GEM_AGENT_TOKEN=
