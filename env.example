# ==============================================================================
# GEM Agent Builder — environment
# ==============================================================================
# Copy to `.env.local` for dev, or set in Vercel project settings for prod.
# Every var is validated at boot via lib/env.ts — missing required vars fail fast.
# ==============================================================================

# --- REQUIRED: Agent model ---------------------------------------------------
# Claude API key. Scope: full. Owner: platform team.
ANTHROPIC_API_KEY=sk-ant-...
# Override if you want to pin a specific model snapshot; default shown.
ANTHROPIC_MODEL=claude-opus-4-7

# --- REQUIRED (prod): Vercel Sandbox authentication --------------------------
# In Vercel production, OIDC is injected automatically — leave these blank.
# For local dev, run: `vercel link && vercel env pull` (writes VERCEL_OIDC_TOKEN).
# For external CI / non-Vercel hosts, set VERCEL_TOKEN + TEAM_ID + PROJECT_ID.
VERCEL_OIDC_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- OPTIONAL: Auto-deploy on green tests ------------------------------------
# Vercel → Project → Settings → Git → Deploy Hooks → Create Hook.
# Name it "gem-agent" and point it at the branch you want auto-deployed.
VERCEL_DEPLOY_HOOK_URL=

# --- OPTIONAL: Open PRs on chat → commit → deploy flow -----------------------
# Fine-grained PAT with: Contents RW, Pull Requests RW on target repos.
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=

# --- OPTIONAL: Route authentication ------------------------------------------
# If set, /api/agent and /api/deploy require `Authorization: Bearer <token>`.
# Unset → routes are open (fine for local dev). MUST be set for public deploys.
# Generate with: `openssl rand -hex 32`
GEM_AGENT_TOKEN=

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
